{
  "name": "@cleverforge/payload-eventbrite",
  "version": "0.3.0-beta.0",
  "description": "Standalone Payload CMS plugin for Eventbrite event synchronization and webhooks.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./admin": "./admin.js"
  },
  "files": [
    "dist",
    "admin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "pack:check": "npm run exports:check && npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "exports:check": "npm run build && node -e \"import('./dist/index.js').then(m => { if (!m.eventbritePlugin) process.exit(1) })\"",
    "test:unit": "node --import tsx --test tests/client.test.ts tests/config.test.ts tests/conflict-policy.test.ts tests/reconcile.test.ts tests/normalize.test.ts tests/resolvers.test.ts tests/webhook.test.ts tests/venues.test.ts tests/organizers.test.ts",
    "test:integration": "node --import tsx --test tests/payload.integration.test.ts tests/endpoints.integration.test.ts tests/paid-update.integration.test.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "eventbrite",
    "events",
    "webhooks",
    "calendar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CleverForgeAi/payload-eventbrite.git"
  },
  "bugs": {
    "url": "https://github.com/CleverForgeAi/payload-eventbrite/issues"
  },
  "homepage": "https://github.com/CleverForgeAi/payload-eventbrite#readme",
  "peerDependencies": {
    "payload": ">=3.0.0 <4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "payload": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@payloadcms/db-sqlite": "^3.0.0",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
